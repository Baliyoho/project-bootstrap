{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-bootstrap/mutants.schema.json",
  "title": "mutation 規格（src/project_bootstrap/mutants.json）",
  "description": "只驗結構。原文是否在目標檔恰好出現一次、測試是否真的擋下，由 mutants.py 實跑判定。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "groups"],
  "properties": {
    "schema": {"const": 1},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tests", "mutants"],
        "properties": {
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^tests\\.test_[a-z0-9_]+$", "not": {"pattern": "_repo$"}}
          },
          "mutants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "old", "new"],
              "properties": {
                "file": {"type": "string", "pattern": "^src/project_bootstrap/[a-z0-9_]+\\.(py|sh)$"},
                "old": {"type": "string", "minLength": 1},
                "new": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
