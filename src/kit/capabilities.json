      "alternative": "照 AGENTS.md「開工第一件事」手動讀全域 handoff 程序檔"
    },
    "hooks": {
      "label": "Hooks",
      "strict": false,
      "impact": "開場沒有 git 新鮮度與「工作中」判讀，push 前沒有提醒",
      "alternative": "A1／A2.5 照 mode-a-stop.md 手動判讀；push 前手動走 B"
    },
    "session-end-event": {
      "label": "關閉 session 時有事件",
      "strict": false,
      "impact": "關掉 session 時沒有最後提醒，漏交棒要等下一棒才發現",
      "alternative": "收工時手動走 B；下一棒照 mode-a-stop.md 的漏交棒補救"
    },
    "push-reminder": {
      "label": "push 前提醒（PreToolUse）",
      "strict": false,
      "impact": "push 前沒有自動提醒，收工可能漏寫 HANDOFF 就推上去",
      "alternative": "收工照 handoff skill 的 B 模式手動走，push 前自己核對 HANDOFF"
    },
    "managed-write-gate": {
      "label": "受控寫入閘",
      "strict": true,
      "impact": "agent 可以直接寫正式工作樹，規則只能提醒、不能阻擋",
      "alternative": "只能用相容模式：提示與事後偵測，阻擋類需求標未達成"
    }
  },
