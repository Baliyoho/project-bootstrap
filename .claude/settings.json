{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-cdup).claude/hooks/repo-git-check.sh\"",
            "timeout": 30,
            "statusMessage": "檢查 git 是否與 origin 同步…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-cdup).claude/hooks/repo-pre-push.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
