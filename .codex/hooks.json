{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-cdup).claude/hooks/repo-git-check.sh\"",
            "commandWindows": "cmd /d /c \"$((git rev-parse --show-cdup) -replace '/','\\').claude\\hooks\\codex-hook.cmd\" repo-git-check.sh",
            "timeout": 30,
            "statusMessage": "檢查 git 是否與 origin 同步…"
          }
        ]
      }
    ]
  }
}
